# mock: real tools + extractive evidence preview, no LLM; live: real model
PAPERPILOT_MODE=mock
PAPERPILOT_DATA_DIR=./data
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-name
OPENAI_API_KEY=
# Optional provider-specific JSON. Bailian hybrid models: {"enable_thinking":false}
PAPERPILOT_MODEL_EXTRA_BODY={}
# Ollama: OPENAI_BASE_URL=http://localhost:11434/v1; OPENAI_API_KEY=ollama
# Every live run pauses for explicit consent before sending data to the model.
PAPERPILOT_API_URL=http://127.0.0.1:8000
